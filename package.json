{
  "name": "arcadeo",
  "version": "1.0.0",
  "description": "Shared component library for vanilla browser games",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "arcadeo": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./storage": {
      "import": "./dist/esm/components/storage/index.js",
      "require": "./dist/cjs/components/storage/index.cjs",
      "types": "./dist/types/components/storage/index.d.ts"
    },
    "./preferences": {
      "import": "./dist/esm/components/preferences/index.js",
      "require": "./dist/cjs/components/preferences/index.cjs",
      "types": "./dist/types/components/preferences/index.d.ts"
    },
    "./knob": {
      "import": "./dist/esm/components/knob/index.js",
      "require": "./dist/cjs/components/knob/index.cjs",
      "types": "./dist/types/components/knob/index.d.ts"
    },
    "./grid": {
      "import": "./dist/esm/components/grid/index.js",
      "require": "./dist/cjs/components/grid/index.cjs",
      "types": "./dist/types/components/grid/index.d.ts"
    },
    "./draggable": {
      "import": "./dist/esm/components/draggable/index.js",
      "require": "./dist/cjs/components/draggable/index.cjs",
      "types": "./dist/types/components/draggable/index.d.ts"
    },
    "./swipeable": {
      "import": "./dist/esm/components/swipeable/index.js",
      "require": "./dist/cjs/components/swipeable/index.cjs",
      "types": "./dist/types/components/swipeable/index.d.ts"
    },
    "./theme": {
      "import": "./dist/esm/components/theme/index.js",
      "require": "./dist/cjs/components/theme/index.cjs",
      "types": "./dist/types/components/theme/index.d.ts"
    },
    "./game": {
      "import": "./dist/esm/components/game/index.js",
      "require": "./dist/cjs/components/game/index.cjs",
      "types": "./dist/types/components/game/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/components/",
    "src/registry.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=src/components",
    "test-ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --testPathPattern=src/components",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "game",
    "components",
    "vanilla",
    "browser"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/html": "^8.4.7",
    "@storybook/html-vite": "^8.4.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.1",
    "@types/sinon": "^17.0.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "memfs": "^4.9.3",
    "rollup": "^4.28.1",
    "rollup-plugin-copy": "^3.5.0",
    "sinon": "^15.2.0",
    "storybook": "^8.4.7",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.2.0",
    "prompts": "^2.4.2"
  }
}

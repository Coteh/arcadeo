{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "declarationDir": "./dist/types",
        "emitDeclarationOnly": true,
        "outDir": "./dist",
        "allowImportingTsExtensions": false
    },
    "include": ["src"],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.stories.ts",
        "**/*.test.ts",
        "**/*.stories.ts",
    ]
}
